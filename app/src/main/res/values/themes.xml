<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RunningPull" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_teal</item>
        <item name="colorOnPrimary">@color/health_on_primary</item>
        <item name="colorSecondary">@color/health_blue</item>
        <item name="colorOnSecondary">@color/health_on_primary</item>
    </style>

    <style name="Theme.RunningPull" parent="Base.Theme.RunningPull" />

    <!-- adaptive icon은 런처 밖에서는 원형 마스크가 안 씌워져 사각형으로 그려진다.
         앱 아이콘을 화면 안에서 동그랗게 보여주려면 이렇게 직접 깎아야 한다. -->
    <style name="ShapeAppearanceOverlay.RunningPull.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>